<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.SamiBoxTV" parent="Theme.AppCompat.NoActionBar">
        <!-- Fondo nativo Cyberpunk oscuro para eliminar el destello blanco del sistema -->
        <item name="android:windowBackground">#0B0D13</item>
        <item name="android:colorBackground">#0B0D13</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <!-- Evitar renderizado de ventana previa blanca del sistema -->
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <!-- Android 12+ (Google TV): forzar fondo del Splash nativo oscuro -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#0B0D13</item>
    </style>
</resources>